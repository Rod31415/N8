  .def cFalse 0
  .def cTrue 1

init:
  lidt &iterrupt_table
  sti
  pshw #osString
  jsr #printString
  pshw #osCommandString
  jsr #printString
.first:
  ld A#0
  mov A,SP
  pshw #inputBuffer
.loop:
  jsr #keyboard_consume
  cmp A#0x0
  
; Hay una letra en el buffer
  bne #.keyDetected
  jmp #.loop
.keyDetected:
  st A&0x2000
  cmp A#0xd
  jpz #.newline
;Guarda la letra en stack pointer  
  psh A
  mov SP,FP
; input buffer
  add FP,SP#3
; Guardo la letra en FP
  st A[&FP]
  pshb #3+3
  jsr #addFrameWord
  add SP#1
; Rescato la letra del stack pointer
  pop A
; Si es enter
  cmp A#0xd
  jpz #.newline

  rts
.newline:
  ld A#0xa
  st A&0x2000
  ld A#cFalse
  beq #compareCommands
  jsr #emptyInputBuffer
  pshw #osCommandString
  jsr #printString
  jmp #.first



printString:
  mov SP,FP  
.loop:
; Input string FP
  add FP,SP#2
  ld A[&FP] ; Cargo la letra
  cmp A#0x0
  jpz #.end
  st A&0x2000
  pshb #3+2
  jsr #addFrameWord
  add SP#1
  jmp #.loop

.end:
  rts

compareCommands:
  ; Paso los dos string para comparar
  pshw #inputBuffer
  pshw #ListString
  jsr #compareString
  add SP#4
  cmp A#cTrue
  jpz #isList

  pshw #inputBuffer
  pshw #RunString
  jsr #compareString
  add SP#4
  cmp A#cTrue
  jpz #isRun

  jmp #noCommand

isList:
  
  pshw #ListWel
  jsr #printString
  add SP#2
  rts

isRun:
  
  pshw #RunWel
  jsr #printString
  add SP#2
  rts

noCommand:
  pshw #noCmd
  jsr #printString
  add SP#2
  rts

emptyInputBuffer:

  pshw #inputBuffer
  mov SP,FP
.loop:
  mov SP,FP
  ld A[&FP]
  cmp A#0xff
  jpz #.end
  ld A#0
  st A[&FP]
  pshb #3+0
  jsr #addFrameWord
  add SP#1
  
  jmp #.loop
.end:
  
  add SP#2
  rts

compareString:
  mov SP,FP
.loop:
  add FP,SP#4 ;primer input
  ld A[&FP]
  add FP,SP#2
  ld B[&FP]
  cmp
  jnz #.retFalse
  cmp A#0
  jpz #.retTrue
  
  pshb #4+3
  jsr #addFrameWord
  add SP#1
  
  pshb #2+3
  jsr #addFrameWord
  add SP#1
  jmp #.loop

.retFalse:
  ld A#cFalse
  rts

.retTrue:
  ld A#cTrue
  rts


addFrameWord:
  mov SP,FP
  add FP,SP#2
  
  add FP,SP[FP]
;LSB suma 1
  ld A[FP]
  add A#1
  st A[FP]

  add FP#1
  
; MSB acarreo
  ld A[FP]
  adc A#0x0
  st A[FP]

  rts

iterrupt_table:
    .dw timer_handler
    .dw keyboard_handler

timer_rise:
    .res 1
timer_handler:
    ld A&timer_counter
    add A#0x1
    st A&timer_counter

    ld A&timer_counter+1
    adc A#0x0
    st A&timer_counter+1

    ld A&timer_counter+2
    adc A#0x0
    st A&timer_counter+2

    ld A&timer_counter+3
    adc A#0x0
    st A&timer_counter+3

    ld A#0x1
    st A&timer_rise

    iret
timer_counter:
    .res 4

keyboard_handler:
    ld A&0x2000
    st A%keyboard_counter

    ld A&keyboard_counter
    add A#0x1
    st A&keyboard_counter

    ld A&keyboard_counter+1
    adc A#0x0
    st A&keyboard_counter+1
    iret

keyboard_consume:
    ld A&keyboard_counter
    sub A#0x1
    st A&keyboard_counter

    ld A&keyboard_counter+1
    sbc A#0x0
    st A&keyboard_counter+1

    ld A%keyboard_counter
    cmp A#0x0
    jpz #.new
    rts
.new:
    ld A&keyboard_counter
    add A#0x1
    st A&keyboard_counter

    ld A&keyboard_counter+1
    adc A#0x0
    st A&keyboard_counter+1
    ld A#0x0
    rts
    nop
keyboard_counter:
  .dw keyboard_buffer

keyboard_buffer:
  .res 32



ListString:
  .string "LIST",0
RunString:
  .string "RUN",0
ListWel:
  .string "Bienvenido a la lista",0xa,0
RunWel:
  .string "Se ejecutara el programa",0xa,0
LoadString:
  .string "LOAD",0

noCmd:
  .string "No se encontro el comando",0xa,0

osString:
3+.6
  .string "        __    __            __   ______    ______  ",0xa
  .string "       /  \  /  |          /  | /      \  /      \ ",0xa
  .string "       $$  \ $$ |  ______  $$/ /$$$$$$  |/$$$$$$  |",0xa
  .string "       $$$  \$$ | /      \ /  |$$ |  $$ |$$ \__$$/ ",0xa
  .string "       $$$$  $$ |/$$$$$$  |$$ |$$ |  $$ |$$      \ ",0xa
  .string "       $$ $$ $$ |$$    $$ |$$ |$$ |  $$ | $$$$$$  |",0xa
  .string "       $$ |$$$$ |$$$$$$$$/ $$ |$$ \__$$ |/  \__$$ |",0xa
  .string "       $$ | $$$ |$$       |$$ |$$    $$/ $$    $$/ ",0xa
  .string "       $$/   $$/  $$$$$$$/ $$/  $$$$$$/   $$$$$$/  ",0xa,0xa,0x0
osCommandString:
  .string " ->",0x0
inputBuffer:
  .res 32
end:
  hlt
